# Base da API SIGTAP. Em dev pode usar o caminho relativo abaixo (o Vite faz proxy
# para VITE_DEV_API_PROXY). Em produção, aponte para a URL absoluta da API.
VITE_API_BASE_URL=/api/v1/sigtap

# Alvo do proxy de dev (apenas em desenvolvimento). Backend Django local:
VITE_DEV_API_PROXY=http://localhost:8000
